# Postgres connection string (Neon via Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=postgres://user:pass@host/db
# The password you type to log in
APP_PASSWORD=choose-something-long
# Any long random string; signs your login cookie
SESSION_SECRET=generate-a-long-random-string
# Optional — enables AI strip reading, personal daily line, and smart import
ANTHROPIC_API_KEY=sk-ant-...
# Optional — connect Oura (Settings → Oura shows the redirect URI to register)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Optional — any long random string; lets the daily Oura sync cron run
CRON_SECRET=
